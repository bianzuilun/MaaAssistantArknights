<UserControl
    x:Class="MaaWpfGui.Views.UserControl.Toolbox.GarrisonProtocolUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:vm="clr-namespace:MaaWpfGui.ViewModels.UserControl.Toolbox"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type vm:GarrisonProtocolUserControlModel}}"
    d:DesignWidth="220"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <hc:ScrollViewer IsInertiaEnabled="True" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,5">
                <Button
                    MinWidth="50"
                    Margin="4,0,0,0"
                    VerticalAlignment="Bottom"
                    Command="{s:Action SelectFarmDir}"
                    Content="{DynamicResource Select}"
                    DockPanel.Dock="Right" />
                <TextBox
                    VerticalContentAlignment="Center"
                    hc:InfoElement.Title="{DynamicResource MiniGame@GarrisonProtocol@FarmDir}"
                    Text="{Binding FarmDir, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <DockPanel Margin="0,5">
                <Button
                    MinWidth="50"
                    Margin="4,0,0,0"
                    VerticalAlignment="Bottom"
                    Command="{s:Action SelectModelPath}"
                    Content="{DynamicResource Select}"
                    DockPanel.Dock="Right" />
                <TextBox
                    VerticalContentAlignment="Center"
                    hc:InfoElement.Placeholder="{DynamicResource MiniGame@GarrisonProtocol@ModelPathPlaceholder}"
                    hc:InfoElement.Title="{DynamicResource MiniGame@GarrisonProtocol@ModelPath}"
                    Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBox
                Margin="0,5"
                VerticalContentAlignment="Center"
                hc:InfoElement.Title="{DynamicResource MiniGame@GarrisonProtocol@PythonPath}"
                Text="{Binding PythonPath, UpdateSourceTrigger=PropertyChanged}" />
            <hc:NumericUpDown
                Margin="0,5"
                hc:InfoElement.Title="{DynamicResource MiniGame@GarrisonProtocol@GameCount}"
                Maximum="20"
                Minimum="1"
                Value="{Binding GameCount}" />
            <TextBox
                Margin="0,5"
                VerticalContentAlignment="Center"
                hc:InfoElement.Placeholder="{DynamicResource MiniGame@GarrisonProtocol@NeedBondsPlaceholder}"
                hc:InfoElement.Title="{DynamicResource MiniGame@GarrisonProtocol@NeedBonds}"
                Text="{Binding NeedBonds, UpdateSourceTrigger=PropertyChanged}" />
            <controls:TextBlock
                Margin="5"
                Style="{StaticResource TextBlockDefault}"
                Text="{DynamicResource MiniGame@GarrisonProtocolTip}"
                TextWrapping="Wrap" />
        </StackPanel>
    </hc:ScrollViewer>
</UserControl>
